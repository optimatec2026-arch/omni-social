// ==========================================
// PROCESSAMENTO DOS DADOS E ARQUIVOS
// ==========================================
app.post('/enviar', verificarAuth, upload.single('arquivo'), (req, res) => {
    const { rede, telefones, mensagem } = req.body;
    const arquivoEnviado = req.file ? req.file.originalname : null;

    if (!telefones || !mensagem) {
        return res.send(`<script>alert('Preencha todos os campos obrigatórios.'); window.location.href='/';</script>`);
    }

    const listaDestinatarios = telefones.split(/[\n,]/).map(t => t.trim()).filter(t => t.length > 0);
    const horaAtual = new Date().toLocaleTimeString('pt-BR');

    try {
        for (let destino of listaDestinatarios) {
            console.log(`[ENTERPRISE] Canal: ${rede} | Destino: ${destino} | Anexo: ${arquivoEnviado || 'Nenhum'}`);
            
            db.run(`INSERT INTO disparos (rede, destino, mensagem, midia, hora) VALUES (?, ?, ?, ?, ?)`, 
                [rede, destino, mensagem, arquivoEnviado, horaAtual]);
        }

        res.send(`<script>alert('Lote executado com sucesso na rede ${rede}!'); window.location.href='/';</script>`);
    } catch (error) {
        console.error('Erro no processamento:', error);
        res.send(`<script>alert('Erro crítico ao processar o lote.'); window.location.href='/';</script>`);
    }
});

app.listen(PORT, () => {
    console.log(`Optima Tec Enterprise rodando na porta ${PORT}`);
});
