// ==========================================
// PROCESSAMENTO GERAL
// ==========================================
app.post('/enviar', verificarAuth, upload.single('arquivo'), (req, res) => {
    const { rede, telefones, mensagem } = req.body;
    const arquivoEnviado = req.file ? req.file.originalname : null;

    if (!telefones || !mensagem) {
        return res.send(`<script>alert('Preencha os campos obrigatórios!'); window.location.href='/';</script>`);
    }

    const listaDestinatarios = telefones.split(/[\n,]/).map(t => t.trim()).filter(t => t.length > 0);
    const horaAtual = new Date().toLocaleTimeString('pt-BR');

    try {
        for (let destino of listaDestinatarios) {
            console.log(`[OMNI-SOCIAL COMPLETO] Rede: ${rede} | Destino: ${destino} | Mídia: ${arquivoEnviado || 'Nenhuma'}`);
            
            // Grava no banco de dados SQLite
            db.run(`INSERT INTO disparos (rede, destino, mensagem, midia, hora) VALUES (?, ?, ?, ?, ?)`, 
                [rede, destino, mensagem, arquivoEnviado, horaAtual]);
        }

        res.send(`<script>alert('Ação executada com sucesso para ${rede}!'); window.location.href='/';</script>`);
    } catch (error) {
        console.error('Erro na execução:', error);
        res.send(`<script>alert('Erro ao processar a solicitação.'); window.location.href='/';</script>`);
    }
});

app.listen(PORT, () => {
    console.log(`Optima Tec Omni-Social Completo rodando na porta ${PORT}`);
});
